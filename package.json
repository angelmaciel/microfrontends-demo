{
  "name": "microfrontends-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda mínima con microfrontends en React (Module Federation), Redux, JWT y Material UI",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,host,catalogo,carrito -c blue,magenta,green,yellow \"npm run dev -w @demo/api\" \"npm run dev -w @demo/host\" \"npm run dev -w @demo/catalogo\" \"npm run dev -w @demo/carrito\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "verificar": "npm run lint && npm run typecheck && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
